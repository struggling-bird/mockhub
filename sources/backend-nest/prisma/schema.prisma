generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String    @id @map("id")
  email     String    @unique @map("email")
  password  String    @map("password")
  username  String?   @map("username")
  company   String?   @map("company")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  projects  Project[]
  memberships ProjectMember[]
  sentInvitations ProjectInvitation[] @relation("InvitationInviter")

  @@map("users")
}

model Project {
  id          String      @id @default(cuid())
  name        String
  description String?
  logoUrl     String?     @map("logo_url")
  proxyUrl    String?     @map("proxy_url")
  mockKey     String      @unique @map("mock_key")
  defaultMockMode String? @map("default_mock_mode")
  autoCapture Boolean? @map("auto_capture")
  cookieRewriteMode String? @map("cookie_rewrite_mode")
  cookieRewriteDomain String? @map("cookie_rewrite_domain")
  ownerId     String      @map("owner_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  apis        ProjectApi[]
  requestLogs RequestLog[]
  assets      PublicAsset[]
  members     ProjectMember[]
  invitations ProjectInvitation[]
  roles       ProjectRoleDefinition[]
  rolePermissions ProjectRolePermission[]

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("projects")
}

model ProjectRoleDefinition {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  roleKey     String   @map("role_key")
  name        String
  description String?  @map("description")
  systemRole  Boolean  @default(false) @map("system_role")
  locked      Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, roleKey])
  @@index([projectId])
  @@map("project_roles")
}

model ProjectRolePermission {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  role          String
  permissionKey String   @map("permission_key")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, role, permissionKey])
  @@index([projectId])
  @@map("project_role_permissions")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String
  status    String   @default("Active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_members")
}

model ProjectInvitation {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  email       String
  role        String
  token       String    @unique
  status      String    @default("Pending")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([email])
  @@index([status])
  @@map("project_invitations")
}

model PublicAsset {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  value     String   @db.Text
  type      String
  category  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("public_assets")
}

model ProjectApi {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  path      String
  method    String
  status    String   @default("New")

  // 接口文档 & Mock 相关配置，统一存为 JSON/TEXT
  requestHeaders   String? @map("request_headers")
  requestParams    String? @map("request_params")
  responseHeaders  String? @map("response_headers")
  responseSchema   String? @map("response_schema")
  mockStaticBody   String? @map("mock_static_body")
  mockScript       String? @map("mock_script")
  mockMode         String? @map("mock_mode")
  mockProxyUrl     String? @map("mock_proxy_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestLogs RequestLog[]

  @@index([projectId])
  @@map("project_apis")
}

model RequestLog {
  id           String   @id @default(cuid())
  projectId    String   @map("project_id")
  apiId        String?  @map("api_id")
  method       String
  path         String
  mode         String?
  statusCode   Int      @map("status_code")
  durationMs   Int      @map("duration_ms")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  api     ProjectApi? @relation(fields: [apiId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([apiId])
  @@map("request_logs")
}
